import random
import math

N = 8

def cost(board):
    c = 0
    for i in range(N):
        for j in range(i + 1, N):
            if board[i] == board[j]:
                c += 1
            if abs(board[i] - board[j]) == abs(i - j):
                c += 1
    return c

def print_board(board):
    for i in range(N):
        for j in range(N):
            print("Q" if board[j] == i else ".", end=" ")
        print()

def simulated_annealing():
    board = [random.randint(0, N - 1) for _ in range(N)]
    current = cost(board)
    temperature = 100

    for _ in range(100000):
        if current == 0:
            return board

        col = random.randint(0, N - 1)
        old_row = board[col]
        board[col] = random.randint(0, N - 1)

        new = cost(board)
        delta = new - current

        if delta <= 0:
            current = new
        elif random.random() >= math.exp(-delta / temperature):
            board[col] = old_row
        else:
            current = new

        temperature *= 0.995
        temperature = max(temperature, 0.0001)

    return None

solution = simulated_annealing()

if solution:
    print_board(solution)
else:
    print("No solution found")
